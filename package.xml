<package format="3">
  <name>evologics_usbl_driver</name>
  <version>0.1.0</version>
  <description>Driver for the Evologics USBL Underwater Communication Device</description>

  <maintainer email="allan.almeida@fieb.org.br">Allan Almeida</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>

  <!-- Runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>ros_driver_base</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>boost</depend>

  <doc_depend>ament_cmake_doxygen</doc_depend>

  <!-- Export build type -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
